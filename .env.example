# ==============================================================================
# Variables de Entorno — NuevaMente (Backend & Frontend)
# ==============================================================================

# --- Proveedor LLM y Embeddings (Cohere) ---
COHERE_API_KEY=ingresar-api 
COHERE_MODEL=command-r-plus-08-2024
EMBEDDING_MODEL=embed-multilingual-v3.0

# --- Parámetros de Calidad y Orquestación ---
MIN_ANCLAJE_FUENTE_SCORE=0.75
MAX_REDACCION_RETRIES=2
TOP_K=5
MIN_SCORE_RETRIEVAL=0.60

# --- Vector Store (ChromaDB) ---
CHROMA_PATH=data/chroma
CHROMA_COLLECTION_NAME=nuevamente_documentos

# --- Puertos de Despliegue ---
BACKEND_PORT=8000
FRONTEND_PORT=8501
# Puedes cambiar FRONTEND_PORT a 8502 si el 8501 está ocupado:
# FRONTEND_PORT=8502

# --- OCI Object Storage (Opcional: solo para activación del cliente real) ---
# OCI_CONFIG_FILE=~/.oci/config
# OCI_CONFIG_PROFILE=DEFAULT
# OCI_NAMESPACE=tu_namespace_oci
# OCI_BUCKET_NAME=tu_bucket_oci
