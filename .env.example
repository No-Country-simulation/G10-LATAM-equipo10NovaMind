# --- Cohere / Agentes ---

COHERE_API_KEY=

# Modelo de generacion de Agente 2 y Agente 3
COHERE_MODEL=command-a-03-2025

# Modelo de embeddings de Agente 1
COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0

# Persistencia local de Chroma de Agente 1
AGENTE1_CHROMA_PATH=./chroma_db

# Coleccion de Chroma de Agente 1
AGENTE1_COLLECTION_NAME=nuevamente_documentos

# --- Critico ---

# Score minimo para aceptar el contenido
MIN_ANCLAJE_FUENTE_SCORE=0.75

# Maximo de reintentos de redaccion
MAX_REDACCION_RETRIES=2
