# ==============================================================================
# Variables de Entorno — NovaMind (Backend FastAPI & Frontend React Vite)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Agente 1 (Investigador) & Agente 2 (Productor): Cohere API
# ------------------------------------------------------------------------------
COHERE_API_KEY=tu_cohere_api_key_aqui
COHERE_MODEL=command-r-08-2024
EMBEDDING_MODEL=embed-multilingual-v3.0

# ------------------------------------------------------------------------------
# 2. Agente 3 (Auditor Crítico RAG): Multi-Proveedor con Failover Automático
# ------------------------------------------------------------------------------
# Proveedor principal del Crítico (Gemini Flash para auditoría matemática ultrarrápida)
GEMINI_API_KEY=tu_gemini_api_key_aqui
PROVEEDOR_CRITICO=gemini
MODELO_CRITICO=gemini-2.5-flash

# Proveedor de respaldo (Groq LPU para auto-failover en milisegundos si Gemini satura cuota)
GROQ_API_KEY=tu_groq_api_key_aqui
PROVEEDOR_CRITICO_FALLBACK=groq
MODELO_CRITICO_FALLBACK=qwen/qwen3.8-27b

# Proveedor alternativo opcional
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui

# Generación paralela con Gemini (modo_rag=paralelo). La clave GEMINI_API_KEY
# vive SOLO en el backend: nunca uses una variable VITE_* para claves de API.
GEMINI_SUMMARY_MODEL=gemini-3.8-flash
GEMINI_RESOURCES_MODEL=gemini-3.5-flash-lite
# Respaldo por tarea si el principal da 429, 5xx o timeout (vacío = sin respaldo)
GEMINI_SUMMARY_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_RESOURCES_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# Voz del video narrado (Estación 4). ElevenLabs es la voz principal; si falta la clave,
# no quedan créditos o falla, se usa GEMINI_TTS_MODEL. Solo backend: nunca VITE_*.
# Permisos mínimos de la clave: Texto a voz (Acceso), Voces (Leído), Modelos y Usuario (Acceso).
ELEVENLABS_API_KEY=tu_elevenlabs_api_key_aqui
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_VOICE_NAME=Alice
# Llamadas simultáneas a Gemini por proceso (la cuota es por proyecto)
# GEMINI_MAX_CONCURRENCIA=4

# Seguridad (auditoría Fase 1)
# PERMITIR_MODO_INVITADO=true   # por defecto: activo fuera de APP_ENV=prod
# MAX_INVITADOS_CONCURRENTES=2
# MAX_BYTES_ARCHIVO=15728640
# TIEMPO_MAX_ADAPTACION_S=300

# ------------------------------------------------------------------------------
# 3. Parámetros de Calidad Pedagógica y Orquestación (LangGraph)
# ------------------------------------------------------------------------------
MIN_ANCLAJE_FUENTE_SCORE=0.75
MAX_REDACCION_RETRIES=2
TOP_K=5
MIN_SCORE_RETRIEVAL=0.60
APP_ENV=dev

# ------------------------------------------------------------------------------
# 4. Base Vectorial Local (ChromaDB)
# ------------------------------------------------------------------------------
CHROMA_PATH=data/chroma
CHROMA_COLLECTION_NAME=nuevamente_documentos

# ------------------------------------------------------------------------------
# 5. Persistencia en Oracle Cloud Infrastructure (OCI Object Storage Always Free)
# ------------------------------------------------------------------------------
OCI_USER=ocid1.user.oc1..tu_user_ocid_aqui
OCI_TENANCY=ocid1.tenancy.oc1..tu_tenancy_ocid_aqui
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_REGION=sa-santiago-1
OCI_NAMESPACE=tu_namespace_aqui
OCI_BUCKET_NAME=nuevamente-contenidos-educativos
OCI_KEY_FILE=deploy/oci_api_key.pem

# ------------------------------------------------------------------------------
# 6. Puertos Locales y Comunicación Frontend-Backend
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173

# URL del backend consumida por la SPA en React 19 + Vite:
VITE_API_URL=http://localhost:8000
# Supabase project URL and publishable key used by the backend for Auth and RLS.
# Google OAuth Client ID/Secret are configured in Supabase Dashboard > Auth > Providers > Google;
# never put the Google client secret in this file or in a VITE_* variable.
SUPABASE_URL=https://pvgafxwsmatjebklmqlc.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ccq7F_q_S8hT1lSRGfQrJg_qlzed0pD
