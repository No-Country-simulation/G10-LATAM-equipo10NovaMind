# --- Proveedor de LLM ---
# "gemini" (principal, tier gratuito) | "ollama" (fallback local) | "claude" (opcional)
LLM_PROVIDER=gemini

GEMINI_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Embeddings ---
# "local" (sentence-transformers, sin dependencia de red) | "gemini"
EMBEDDINGS_PROVIDER=local
LOCAL_EMBEDDINGS_MODEL=intfloat/multilingual-e5-base

# --- Vector Store (Chroma persistente en disco) ---
CHROMA_PERSIST_DIR=/app/data/chroma
CHROMA_COLLECTION_NAME=nuevamente_docs

# --- OCI Object Storage ---
OCI_CONFIG_FILE=/root/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_NAMESPACE=tu_namespace_de_object_storage
OCI_BUCKET_NAME=nuevamente-contenidos-educativos
OCI_REGION=sa-saopaulo-1

# Ruta en el HOST (fuera del contenedor) donde está el config de OCI, usada por docker-compose
OCI_CONFIG_HOST_PATH=~/.oci

# --- Umbral del Agente Crítico (anclaje_fuente_score mínimo para aceptar sin reescritura) ---
MIN_ANCLAJE_FUENTE_SCORE=0.75
MAX_REDACCION_RETRIES=2
